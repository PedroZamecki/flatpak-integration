#!/bin/bash

# omarchy:summary=Flatpak integration menu actions (setup, permissions, install, remove, update, reset)
# omarchy:group=flatpak
# omarchy:name=menu
# omarchy:args=<setup|configure|check|refresh|permissions|install|remove|update|reset|status>

set -uo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=lib/flatpak-common.sh
source "$SCRIPT_DIR/lib/flatpak-common.sh"

HELPER="$SCRIPT_DIR/omarchy-flatpak-permissions"
INSTALLER="$SCRIPT_DIR/omarchy-flatpak-install"
UPDATER="$SCRIPT_DIR/omarchy-flatpak-update"
SETUP="$SCRIPT_DIR/omarchy-flatpak-setup"

notify() {
  if fp_have omarchy-notification-send; then
    omarchy-notification-send "Flatpak" "$1"
  else
    echo "$1" >&2
  fi
}

# Run an interactive command visibly. Omarchy's floating terminal keeps the
# logo/done presentation consistent with the rest of the desktop.
run_in_terminal() {
  local cmd="$1"
  if fp_have omarchy-launch-floating-terminal-with-presentation; then
    exec omarchy-launch-floating-terminal-with-presentation "$cmd"
  elif fp_have xdg-terminal-exec; then
    exec xdg-terminal-exec --app-id=org.omarchy.terminal bash -c "$cmd"
  else
    exec bash -c "$cmd"
  fi
}

ensure_flatpak() {
  if fp_have flatpak; then
    return 0
  fi

  notify "Flatpak is not installed. Opening setup..."
  run_in_terminal "$SETUP setup"
}

case "${1:-}" in
  setup)
    run_in_terminal "$SETUP setup"
    ;;

  configure)
    run_in_terminal "$SETUP configure"
    ;;

  check)
    run_in_terminal "$SETUP check"
    ;;

  status)
    fp_print_status
    ;;

  desktop)
    if ! fp_have flatpak; then
      notify "Flatpak is not installed."
      exit 1
    fi
    if fp_sync_desktop_bridge; then
      notify "App menu refreshed ($(fp_desktop_bridge_count) Flatpak applications)."
    else
      notify "Could not refresh the app menu."
      exit 1
    fi
    ;;

  refresh)
    run_in_terminal "$SETUP repair"
    ;;

  install)
    ensure_flatpak
    run_in_terminal "$INSTALLER"
    ;;

  permissions)
    ensure_flatpak
    apps=$("$HELPER" list-apps)
    if [[ -z $apps ]]; then
      notify "No Flatpak applications installed."
      exit 0
    fi

    selection=$(omarchy-menu-select "Flatpak App to Configure" <<<"$apps") || exit 0
    [[ -n $selection ]] || exit 0

    app_id=$(cut -f2 <<<"$selection")
    app_name=$(cut -f1 <<<"$selection")
    [[ -n $app_id ]] || exit 0

    while true; do
      perms=$("$HELPER" list-permissions "$app_id")
      chosen=$(omarchy-menu-select "$app_name Permissions" <<<"$perms") || break
      [[ -n $chosen ]] || break

      key=$(cut -f2 <<<"$chosen")
      if [[ $key == "done" || -z $key ]]; then
        break
      elif [[ $key == "reset" ]]; then
        msg=$("$HELPER" reset "$app_id")
        notify "$msg"
      else
        msg=$("$HELPER" toggle "$app_id" "$key")
        notify "$msg"
      fi
    done
    ;;

  remove)
    ensure_flatpak
    apps=$("$HELPER" list-apps)
    if [[ -z $apps ]]; then
      notify "No Flatpak applications installed to remove."
      exit 0
    fi

    selection=$(omarchy-menu-select "Remove Flatpak Application" <<<"$apps") || exit 0
    [[ -n $selection ]] || exit 0

    app_id=$(cut -f2 <<<"$selection")
    [[ -n $app_id ]] || exit 0

    flag=$(fp_flag_for_app "$app_id")
    run_in_terminal "flatpak uninstall $flag -y $(printf '%q' "$app_id"); omarchy-flatpak-setup desktop --quiet 2>/dev/null || true; omarchy-shell -q flatpak-integration-update refresh 2>/dev/null || true"
    ;;

  update)
    ensure_flatpak
    run_in_terminal "$UPDATER"
    ;;

  reset)
    ensure_flatpak
    apps=$("$HELPER" list-apps)
    if [[ -z $apps ]]; then
      notify "No Flatpak applications installed."
      exit 0
    fi

    selection=$(omarchy-menu-select "Reset Permissions For App" <<<"$apps") || exit 0
    [[ -n $selection ]] || exit 0

    app_id=$(cut -f2 <<<"$selection")
    [[ -n $app_id ]] || exit 0

    msg=$("$HELPER" reset "$app_id")
    notify "$msg"
    ;;

  *)
    echo "Usage: omarchy-flatpak-menu <setup|configure|check|desktop|refresh|permissions|install|remove|update|reset|status>" >&2
    exit 1
    ;;
esac
