#!/usr/bin/env python3
"""
omarchy-flatpak-permissions: inspection and override engine for Flatpak
permissions.

Permissions are read from the application metadata plus the user and system
override files, and written as per-user overrides. Per-user overrides work for
both per-user and system-wide applications and never need administrator access.
"""

from __future__ import annotations

import subprocess
import sys

PERMISSIONS = [
    {
        "key": "network",
        "label": "Network Access",
        "category": "shared",
