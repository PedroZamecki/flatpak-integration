{
  "schemaVersion": 1,
  "id": "flatpak-integration",
  "name": "Flatpak Integration",
  "version": "2.0.0",
  "author": "Pedro Zamecki Andrade",
  "license": "MIT",
  "description": "Native Flatpak integration with dependency checks, Flathub setup, a Flatseal-like permission manager, and a topbar update indicator for Omarchy.",
  "kinds": [
    "service",
    "bar-widget"
  ],
  "activation": "on-demand",
  "entryPoints": {
    "service": "Service.qml",
    "barWidget": "BarWidget.qml"
  },
  "barWidget": {
    "displayName": "Flatpak Updates",
    "description": "Indicates available Flatpak application updates",
    "category": "System",
    "allowMultiple": false,
    "defaultSection": "center"
  }
}
